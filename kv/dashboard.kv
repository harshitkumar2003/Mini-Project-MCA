<HomeDashboardScreen>:
    BoxLayout:
        orientation: 'vertical'
        spacing: 10
        padding: [10, 10, 10, 0]

        # Top Bar
        BoxLayout:
            size_hint_y: None
            height: 60
            canvas.before:
                Color:
                    rgba: 0.2, 0.6, 0.4, 1  # Green top bar
                Rectangle:
                    pos: self.pos
                    size: self.size

            Image:
                source: "assets/logo2.png"
                size_hint_x: None
                width: 150
                allow_stretch: True
                keep_ratio: True

            Label:
                text: "Health Dashboard"
                font_size: 20
                bold: True
                color: 1, 1, 1, 1
                size_hint_x: 0.6

            Button:
                text: "Logout"
                size_hint_x: None
                width: 100
                background_normal: ""
                background_color: 0.9, 0.1, 0.1, 1
                on_release:
                    app.root.get_screen('login').reset_fields()
                    app.root.current = 'login'

        # Main Content Area
        ScrollView:
            do_scroll_x: False
            bar_width: 10
            bar_color: 0.5, 0.5, 0.5, 0.5
            bar_inactive_color: 0.5, 0.5, 0.5, 0.3
            effect_cls: 'ScrollEffect'

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [16, 10, 16, 30]
                spacing: 20

                # Top Cards Row
                GridLayout:
                    cols: 3
                    spacing: 15
                    size_hint_y: None
                    height: 200
                    padding: [0, 0, 0, 10]

                    InfoCard:
                        id: appointments_card
                        title: "Appointments"
                        value: "0"
                        icon_source: "assets/calendar.jpg"
                        action: root.show_appointment_popup
                        canvas.before:
                            Color:
                                rgba: 0.9, 0.95, 1, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [15,]
                        
                    InfoCard:
                        id: symptoms_card
                        title: "Symptom Tracker"
                        value: "Track"
                        icon_source: "assets/symptoms.png"
                        action: root.show_symptom_tracker
                        canvas.before:
                            Color:
                                rgba: 0.95, 0.95, 1, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [15,]
                        
                    InfoCard:
                        id: doctors_card
                        title: "Find Doctors"
                        value: '8'  # Total number of doctors
                        icon_source: "assets/doctor.png"
                        action: root.show_doctor_list
                        canvas.before:
                            Color:
                                rgba: 0.9, 1, 0.95, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [15,]

                # Doctors Section
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: 320
                    spacing: 10
                    padding: [0, 10, 0, 0]

                    BoxLayout:
                        size_hint_y: None
                        height: 40
                        spacing: 10
                        
                        Label:
                            text: "Available Doctors"
                            font_size: 18
                            bold: True
                            size_hint_x: 0.7
                            color: 0.2, 0.2, 0.2, 1
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size
                            
                        Button:
                            text: "View All"
                            size_hint_x: 0.3
                            background_color: 0.2, 0.6, 0.4, 1
                            color: 1, 1, 1, 1
                            on_release: root.show_doctor_list()
                    
                    # Doctors Horizontal Scroll
                    ScrollView:
                        size_hint_y: 0.9
                        do_scroll_x: True
                        do_scroll_y: False
                        bar_width: 8
                        bar_color: 0.5, 0.5, 0.5, 0.5
                        bar_inactive_color: 0.5, 0.5, 0.5, 0.3
                        
                        GridLayout:
                            id: doctors_container
                            cols: 20
                            spacing: 15
                            size_hint_x: None
                            width: self.minimum_width
                            size_hint_y: 1
                            row_force_default: True
                            padding: [10, 5, 10, 10]
                            row_default_height: 220
                            col_force_default: True
                            col_default_width: 180
                
                # Health Overview Section
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: 400
                    spacing: 10
                    padding: [0, 10, 0, 0]

                    Label:
                        text: "Health Overview"
                        font_size: 18
                        bold: True
                        size_hint_y: None
                        height: 40
                        color: 0.2, 0.2, 0.2, 1
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size

                    BoxLayout:
                        size_hint_y: None
                        height: 350
                        spacing: 15

                        # Left side - Graph
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint: 0.7, 1
                            canvas.before:
                                Color:
                                    rgba: 1, 1, 1, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [15,]
                                    source: 'assets/card_bg.png'
                                Color:
                                    rgba: 0, 0, 0, 0.03
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [15,]
                            padding: 15

                            Graph:
                                id: health_graph
                                xlabel: "Days"
                                ylabel: "Health Score"
                                x_ticks_major: 5
                                y_ticks_major: 20
                                y_grid_label: True
                                x_grid_label: True
                                padding: 5
                                x_grid: True
                                y_grid: True
                                xmin: 0
                                xmax: 30
                                ymin: 0
                                ymax: 100
                                x_grid_color: 0.9, 0.9, 0.9, 1
                                y_grid_color: 0.9, 0.9, 0.9, 1
                                label_options: {'color': [0.4,0.4,0.4,1]}

                        # Right side - Health Stats
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint: 0.3, 1
                            spacing: 15

                            # Health Metrics Card
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint: 1, 0.5
                                canvas.before:
                                    Color:
                                        rgba: 1, 1, 1, 1
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [15,]
                                        source: 'assets/card_bg.png'
                                    Color:
                                        rgba: 0.95, 0.97, 1, 1
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [15,]
                                padding: 15

                                Label:
                                    text: "Health Metrics"
                                    font_size: 16
                                    bold: True
                                    size_hint_y: None
                                    height: 30
                                    color: 0.2, 0.2, 0.2, 1
                                    halign: 'left'
                                    text_size: self.size

                                BoxLayout:
                                    orientation: 'vertical'
                                    spacing: 8
                                    padding: [0, 10, 0, 0]
                                    
                                    BoxLayout:
                                        size_hint_y: None
                                        height: 30
                                        Label:
                                            text: "Heart Rate"
                                            color: 0.5, 0.5, 0.5, 1
                                            size_hint_x: 0.6
                                            halign: 'left'
                                            text_size: self.size
                                        Label:
                                            text: "72 bpm"
                                            color: 0.2, 0.6, 0.4, 1
                                            bold: True
                                            size_hint_x: 0.4
                                            halign: 'right'
                                            text_size: self.size
                                    
                                    BoxLayout:
                                        size_hint_y: None
                                        height: 30
                                        Label:
                                            text: "Blood Pressure"
                                            color: 0.5, 0.5, 0.5, 1
                                            size_hint_x: 0.6
                                            halign: 'left'
                                            text_size: self.size
                                        Label:
                                            text: "120/80 mmHg"
                                            color: 0.2, 0.6, 0.4, 1
                                            bold: True
                                            size_hint_x: 0.4
                                            halign: 'right'
                                            text_size: self.size
                                    
                                    BoxLayout:
                                        size_hint_y: None
                                        height: 30
                                        Label:
                                            text: "Oxygen Level"
                                            color: 0.5, 0.5, 0.5, 1
                                            size_hint_x: 0.6
                                            halign: 'left'
                                            text_size: self.size
                                        Label:
                                            text: "98%"
                                            color: 0.2, 0.6, 0.4, 1
                                            bold: True
                                            size_hint_x: 0.4
                                            halign: 'right'
                                            text_size: self.size
                                    
                                    BoxLayout:
                                        size_hint_y: None
                                        height: 30
                                        Label:
                                            text: "Temperature"
                                            color: 0.5, 0.5, 0.5, 1
                                            size_hint_x: 0.6
                                            halign: 'left'
                                            text_size: self.size
                                        Label:
                                            text: "98.6°F"
                                            color: 0.2, 0.6, 0.4, 1
                                            bold: True
                                            size_hint_x: 0.4
                                            halign: 'right'
                                            text_size: self.size
                                    Label:
                                        text: "Blood Pressure: 120/80"
                                        font_size: 14
                                        color: 0.4, 0.4, 0.4, 1
                                        halign: 'left'
                                    Label:
                                        text: "Glucose: 98 mg/dL"
                                        font_size: 14
                                        color: 0.4, 0.4, 0.4, 1
                                        halign: 'left'

                            # Recent Activities Card
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint: 1, 0.5
                                canvas.before:
                                    Color:
                                        rgba: 0.95, 0.95, 0.95, 1
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [10,]
                                padding: 10

                                Label:
                                    text: "Recent Activities"
                                    font_size: 16
                                    bold: True
                                    size_hint_y: None
                                    height: 30
                                    color: 0.2, 0.2, 0.2, 1

                                ScrollView:
                                    BoxLayout:
                                        orientation: 'vertical'
                                        size_hint_y: None
                                        height: self.minimum_height
                                        spacing: 8
                                        padding: [0, 5, 0, 5]

                                        ActivityItem:
                                            icon: "assets/medicine.png"
                                            text: "Took Medicine - 2:30 PM"
                                        ActivityItem:
                                            icon: "assets/appointment.png"
                                            text: "Appointment - Dr. Smith"
                                        ActivityItem:
                                            icon: "assets/exercise.png"
                                            text: "30 min walk - 7:00 AM"

<InfoCard>:
    value: ''
    title: ''
    icon_source: ''
    action: None
    
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [15,]
        Color:
            rgba: 0.95, 0.97, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12,]
        Color:
            rgba: 0.2, 0.6, 0.4, 0.2
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 12)
            width: 1.5
    
    orientation: 'vertical'

    BoxLayout:
        size_hint_y: None
        height: 60
        padding: [0, 0, 0, 5]
        pos_hint: {'center_x': 0.5}
        size_hint_x: None
        width: 50
        Image:
            source: root.icon_source
            size_hint: None, None
            height: 50
            width: 50
            allow_stretch: True
            mipmap: True
            pos_hint: {'center_x': 0.5}

    Label:
        text: root.title
        font_size: 16
        color: 0.1, 0.3, 0.2, 1
        bold: True
        size_hint_y: None
        height: 24
        text_size: self.width, None
        halign: 'center'
        valign: 'middle'

    Label:
        text: str(root.value)
        font_size: 36
        color: 0.2, 0.6, 0.4, 1
        bold: True
        size_hint_y: None
        height: 50

<ActivityItem@BoxLayout>:
    icon: ""
    text: ""
    size_hint_y: None
    height: 30
    spacing: 8
    padding: [5, 0]
    
    Image:
        source: root.icon
        size_hint_x: None
        width: 20
        size_hint_y: None
        height: 20
        mipmap: True
        
    Label:
        text: root.text
        font_size: 13
        color: 0.4, 0.4, 0.4, 1
        text_size: self.width, None
        halign: 'left'
        valign: 'middle'
