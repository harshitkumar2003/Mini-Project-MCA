<LoginSignupScreen>:
    FloatLayout:
        # Add background illustration
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size
            Color:
                rgba: 1, 1, 1, 1 
            # The illustration placed bottom left, covering ~45% width, ~60% height
            Rectangle:
                source: "assets/ill-1.png"
                pos: self.x, self.y
                size: self.width * 0.90, self.height * 1

        BoxLayout:
            id: card_box
            orientation: 'vertical'
            size_hint: 0.5, 1.4 # Takes 50% of parent width and 50% of parent height
            pos_hint: {"center_x": 0.64, "center_y": 0.4}
            padding: [24, 32, 24, 24] # More top padding for floating effect
            spacing: 16

            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: 40

            # (Logo - kept the same)
            Image:
                source: "assets/logo2.png"
                size_hint_y: None
                height: "94dp"
                allow_stretch: True
                pos_hint: {"center_x": 0.1}
                opacity: 1

            Widget:
                size_hint_y: 0.3
                height: 10

            ScreenManager:
                id: login_views
                size_hint_y: 1

                # -----------------------------------------------------
                # 1. Login View (User ID / Employee ID login)
                # -----------------------------------------------------
                Screen:
                    name: "login_view"
                    ScrollView:
                        do_scroll_x: False
                        do_scroll_y: True
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: 18
                            padding: [0, 0]

                            TextInput:
                                id: user_id_input # <--- UPDATED ID
                                hint_text: "Enter User ID / Employee ID" # <--- UPDATED HINT
                                size_hint_y: None
                                height: 50
                                background_normal: ""
                                background_active: ""
                                background_color: 0.96, 0.96, 0.96, 1
                                foreground_color: 0, 0, 0, 1
                                font_size: 18
                                multiline: False
                                padding: [20, (self.height - self.line_height) / 2]

                            TextInput:
                                id: password_input
                                hint_text: "Password"
                                password: True
                                size_hint_y: None
                                height: 50
                                background_normal: ""
                                background_active: ""
                                background_color: 0.96, 0.96, 0.96, 1
                                foreground_color: 0, 0, 0, 1
                                font_size: 18
                                multiline: False
                                padding: [20, (self.height - self.line_height) / 2]

                            # ❌ REMOVED: role_spinner widget

                            Button:
                                text: "Log In"
                                size_hint_y: None
                                height: 48
                                background_normal: ""
                                background_color: 0.2, 0.6, 0.4, 1
                                color: 1, 1, 1, 1
                                font_size: 18
                                bold: True
                                on_release: root.validate_login()

                            BoxLayout:
                                orientation: 'vertical'
                                size_hint_y: None
                                height: self.minimum_height
                                spacing: 3

                                Button:
                                    text: "Forgot password?"
                                    size_hint_y: None
                                    height: dp(20)
                                    text_size: self.size
                                    halign: 'left'
                                    valign: 'middle'
                                    background_normal: ""
                                    background_color: 0, 0, 0, 0
                                    color: 0.18, 0.34, 0.82, 1
                                    font_size: 17
                                    on_release: root.screen_switch("forgot_view")

                                Button:
                                    text: "Don't have an account Sign Up"
                                    # This button is generally visible, but clicking it only works
                                    # if the selected role is 'user' (handled in Python logic).
                                    size_hint_y: None
                                    height: dp(20)
                                    text_size: self.size
                                    halign: 'left'
                                    valign: 'middle'
                                    background_normal: ""
                                    background_color: 0, 0, 0, 0
                                    color: 0.18, 0.34, 0.82, 1
                                    font_size: 17
                                    on_release: root.screen_switch("signup_view")

                # -----------------------------------------------------
                # 2. Signup View (Only for User role)
                # -----------------------------------------------------
                Screen:
                    name: "signup_view"
                    ScrollView:
                        do_scroll_x: False
                        do_scroll_y: True
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: 15
                            padding: [0, 0]
                            
                            Label:
                                text: "User Registration"
                                size_hint_y: None
                                height: 30
                                font_size: 20
                                bold: True
                                color: 0.2, 0.2, 0.2, 1

                            TextInput:
                                id: name_input
                                hint_text: "Name"
                                size_hint_y: None
                                height: 50
                                background_normal: ""
                                background_active: ""
                                background_color: 0.96, 0.96, 0.96, 1
                                foreground_color: 0, 0, 0, 1
                                font_size: 18
                                multiline: False
                                padding: [20, (self.height - self.line_height) / 2]

                            TextInput:
                                id: email_input
                                hint_text: "Email"
                                size_hint_y: None
                                height: 50
                                background_normal: ""
                                background_active: ""
                                background_color: 0.96, 0.96, 0.96, 1
                                foreground_color: 0, 0, 0, 1
                                font_size: 18
                                multiline: False
                                padding: [20, (self.height - self.line_height) / 2]

                            # AadhaarInput remains for User signup
                            AadhaarInput:
                                id: signup_adhar_input
                                hint_text: "Aadhaar No. (Mandatory)"
                                size_hint_y: None
                                height: 50
                                background_normal: ""
                                background_active: ""
                                background_color: 0.96, 0.96, 0.96, 1
                                foreground_color: 0, 0, 0, 1
                                font_size: 18
                                multiline: False
                                padding: [20, (self.height - self.line_height) / 2]

                            # Phone Input (for OTP reset)
                            TextInput:
                                id: phone_input
                                hint_text: "Phone number (Used for OTP)"
                                input_filter: "int"
                                size_hint_y: None
                                height: 50
                                background_normal: ""
                                background_active: ""
                                background_color: 0.96, 0.96, 0.96, 1
                                foreground_color: 0, 0, 0, 1
                                font_size: 18
                                multiline: False
                                padding: [20, (self.height - self.line_height) / 2]

                            TextInput:
                                id: signup_password_input
                                hint_text: "Password"
                                password: True
                                size_hint_y: None
                                height: 50
                                background_normal: ""
                                background_active: ""
                                background_color: 0.96, 0.96, 0.96, 1
                                foreground_color: 0, 0, 0, 1
                                font_size: 18
                                multiline: False
                                padding: [20, (self.height - self.line_height) / 2]

                            # ❌ REMOVED: signup_role_spinner widget

                            Button:
                                text: "Sign Up"
                                size_hint_y: None
                                height: 48
                                background_normal: ""
                                background_color: 0.2, 0.6, 0.4, 1
                                color: 1, 1, 1, 1
                                font_size: 18
                                bold: True
                                on_release: root.validate_signup()

                            Button:
                                text: "← Back"
                                size_hint_y: None
                                height: 40
                                background_normal: ""
                                background_color: 0, 0, 0, 0
                                color: 0.18, 0.34, 0.82, 1
                                font_size: 18
                                on_release: root.screen_switch("login_view")

                # -----------------------------------------------------
                # 3. Forgot Password View (OTP Request via Phone)
                # -----------------------------------------------------
                Screen:
                    name: "forgot_view"
                    ScrollView:
                        do_scroll_x: False
                        do_scroll_y: False
                        BoxLayout:
                            orientation: "vertical"
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: 15
                            padding: [0, 0]
                            
                            Label:
                                text: "Verify Phone for OTP"
                                size_hint_y: None
                                height: 30
                                font_size: 20
                                bold: True
                                color: 0.2, 0.2, 0.2, 1

                            # 🌟 CHANGE 2: Phone Number Input (Replaces forgot_adhar_input)
                            TextInput:
                                id: forgot_phone_input # <--- UPDATED ID
                                hint_text: "Enter Registered Phone Number"
                                input_filter: "int"
                                size_hint_y: None
                                height: 50
                                background_normal: ""
                                background_active: ""
                                background_color: 0.96, 0.96, 0.96, 1
                                foreground_color: 0, 0, 0, 1
                                font_size: 18
                                multiline: False
                                padding: [18, (self.height - self.line_height) / 2]

                            Button:
                                text: "Get OTP"
                                size_hint_y: None
                                height: 50
                                background_normal: ""
                                background_color: 0.2, 0.6, 0.4, 1
                                color: 1, 1, 1, 1
                                font_size: 18
                                bold: True
                                on_release: root.send_otp()

                            Label:
                                id: otp_notice
                                size_hint_y: None
                                height: 20
                                bold: True
                                color: 0.6, 0.2, 0.05, 1
                                font_size: 17

                            BoxLayout:
                                orientation: "horizontal"
                                spacing: 25
                                size_hint_y: None
                                height: 50

                                TextInput:
                                    id: otp1
                                    input_filter: "int"
                                    multiline: False
                                    halign: "center"
                                    font_size: 18
                                    size_hint_x: 0.15
                                    background_normal: ""
                                    background_active: ""
                                    background_color: 0.96, 0.96, 0.96, 1
                                    foreground_color: 0, 0, 0, 1
                                    on_text: root.on_otp_text(self, self.text)

                                TextInput:
                                    id: otp2
                                    input_filter: "int"
                                    multiline: False
                                    halign: "center"
                                    font_size: 18
                                    size_hint_x: 0.15
                                    background_normal: ""
                                    background_active: ""
                                    background_color: 0.96, 0.96, 0.96, 1
                                    foreground_color: 0, 0, 0, 1
                                    on_text: root.on_otp_text(self, self.text)

                                TextInput:
                                    id: otp3
                                    input_filter: "int"
                                    multiline: False
                                    halign: "center"
                                    font_size: 18
                                    size_hint_x: 0.15
                                    background_normal: ""
                                    background_active: ""
                                    background_color: 0.96, 0.96, 0.96, 1
                                    foreground_color: 0, 0, 0, 1
                                    on_text: root.on_otp_text(self, self.text)

                                TextInput:
                                    id: otp4
                                    input_filter: "int"
                                    multiline: False
                                    halign: "center"
                                    font_size: 18
                                    size_hint_x: 0.15
                                    background_normal: ""
                                    background_active: ""
                                    background_color: 0.96, 0.96, 0.96, 1
                                    foreground_color: 0, 0, 0, 1
                                    on_text: root.on_otp_text(self, self.text)

                            Button:
                                text: "Confirm"
                                size_hint_y: None
                                height: 50
                                background_normal: ""
                                background_color: 0.2, 0.6, 0.4, 1
                                color: 1, 1, 1, 1
                                font_size: 18
                                bold: True
                                on_release: root.verify_otp()

                            Button:
                                text: "← Back"
                                size_hint_y: None
                                height: 40
                                background_normal: ""
                                background_color: 0, 0, 0, 0
                                color: 0.18, 0.34, 0.82, 1
                                font_size: 17
                                on_release: root.screen_switch("login_view")

                # -----------------------------------------------------
                # 4. Reset Password View
                # -----------------------------------------------------
                Screen:
                    name: "reset_password_view"
                    ScrollView:
                        do_scroll_x: False
                        do_scroll_y: False
                        BoxLayout:
                            orientation: "vertical"
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: 15
                            padding: [24, 24]

                            Label:
                                text: "Reset Password"
                                font_size: 22
                                size_hint_y: None
                                height: 50
                                bold: True

                            TextInput:
                                id: new_password_input
                                hint_text: "New Password"
                                password: True
                                size_hint_y: None
                                height: 50
                                background_normal: ""
                                background_active: ""
                                background_color: 0.96, 0.96, 0.96, 1
                                foreground_color: 0, 0, 0, 1
                                font_size: 18
                                padding: [15, (self.height - self.line_height) / 2]

                            TextInput:
                                id: confirm_password_input
                                hint_text: "Confirm Password"
                                password: True
                                size_hint_y: None
                                height: 50
                                background_normal: ""
                                background_active: ""
                                background_color: 0.96, 0.96, 0.96, 1
                                foreground_color: 0, 0, 0, 1
                                font_size: 18
                                padding: [15, (self.height - self.line_height) / 2]

                            Button:
                                text: "Reset Password"
                                size_hint_y: None
                                height: 50
                                background_normal: ""
                                background_color: 0.2, 0.6, 0.4, 1
                                color: 1, 1, 1, 1
                                font_size: 18
                                bold: True
                                on_release: root.reset_password()

                            Button:
                                text: "← Back to Login"
                                size_hint_y: None
                                height: 40
                                background_normal: ""
                                background_color: 0, 0, 0, 0
                                color: 0.18, 0.34, 0.82, 1
                                font_size: 17
                                on_release: root.screen_switch("login_view")