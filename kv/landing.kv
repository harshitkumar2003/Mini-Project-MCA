# Custom Role Card Definition
<RoleCard@ButtonBehavior+BoxLayout>:
    role_name: 'Role'
    role_icon: 'assets/user-icon.png' # Placeholder icon
    orientation: 'vertical'
    spacing: 10
    padding: 15
    size_hint_y: None
    height: 150
    # Card Styling (Clickable Button Behavior)
    canvas.before:
        Color:
            # Change color slightly on press for feedback
            rgba: 0.85, 0.95, 0.9, 1 if self.state == 'normal' else 0.7, 0.85, 0.75, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [15]
    
    Image:
        source: root.role_icon
        size_hint: None, None
        size: [60, 60]
        pos_hint: {'center_x': 0.5}
        allow_stretch: True
        
    Label:
        text: root.role_name
        font_size: '18sp'
        color: 0.2, 0.2, 0.2, 1
        bold: True
        size_hint_y: None
        height: self.texture_size[1]
        
<LandingScreen>:
    name: 'landing'
    
    BoxLayout:
        orientation: 'vertical'
        spacing: 0
        padding: 0
        
        # Header
        BoxLayout:
            size_hint_y: 0.11
            padding: [20, 5]
            canvas.before:
                Color:
                    rgba: 0.2, 0.6, 0.4, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            
            Image:
                source: 'assets/logo2.png'
                size_hint_x: 0.11
                width: self.height
                allow_stretch: True
                keep_ratio: True
                
            Label:
                text: 'Home'
                font_size: '24sp'
                color: 1, 1, 1, 1
                bold: True
                size_hint_x: 0.7
                
            Button:
                text: 'Help'
                size_hint: None, None
                size: [100, 40]
                pos_hint: {'right': 0.95, 'center_y': 0.5}
                background_normal: ''
                background_color: 1,1,1,1
                color: 0.1, 0.4, 0.2, 1
                on_release: app.root.current = 'help'
        
        # Main Content
        ScrollView:
            do_scroll_x: False
            
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [20, 20]
                spacing: 20
                
                # Hero Section
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: 280
                    canvas.before:
                        Color:
                            rgba: 0.9, 0.96, 0.9, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [15]
                    
                    Label:
                        text: 'Your Health, Our Priority'
                        font_size: '28sp'
                        color: 0.1, 0.1, 0.1, 1
                        bold: True
                        size_hint_y: 0.4
                        
                    Label:
                        text: 'Track symptoms, get insights, and connect with healthcare professionals'
                        text_size: self.width, None
                        halign: 'center'
                        valign: 'middle'
                        size_hint_y: 0.2
                        color: 0.3, 0.3, 0.3, 1
                        
                # ----------------------------------------
                # --- NEW ROLE SELECTION SECTION ---
                # ----------------------------------------
                Label:
                    text: 'Select Your Role to Continue'
                    font_size: '24sp'
                    color: 0.2, 0.2, 0.2, 1
                    bold: True
                    size_hint_y: None
                    height: 50

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: 380
                    spacing: 10
                    padding: [20, 20]
                    canvas.before:
                        Color:
                            rgba: 0.2, 0.6, 0.4, 0.1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [15]
                
                    GridLayout:
                        cols: 2
                        spacing: 15
                        size_hint_y: None
                        height: self.minimum_height
                    
                        # Role Card 1: User
                        RoleCard:
                            role_name: 'User'
                            role_icon: 'assets/user-icon.png' 
                            on_release: root.select_role('user')

                        # Role Card 2: Patient
                        RoleCard:
                            role_name: 'Patient'
                            role_icon: 'assets/patient-icon.png' 
                            on_release: root.select_role('patient')

                        # Role Card 3: Doctor
                        RoleCard:
                            role_name: 'Doctor'
                            role_icon: 'assets/doctor-icon.png'
                            on_release: root.select_role('doctor')

                        # Role Card 4: Admin
                        RoleCard:
                            role_name: 'Admin'
                            role_icon: 'assets/admin-icon.png'
                            on_release: root.select_role('admin')
                
                # ----------------------------------------
                # Features Section (Original Content continues below)
                # ----------------------------------------
                
                Label:
                    text: 'Key Features'
                    font_size: '24sp'
                    color: 0.2, 0.2, 0.2, 1
                    bold: True
                    size_hint_y: None
                    height: 50
                    
                # Feature Cards
                GridLayout:
                    cols: 1
                    spacing: 15
                    size_hint_y: None
                    height: self.minimum_height
                    
                    # Feature 1
                    BoxLayout:
                        size_hint_y: None
                        height: 100
                        canvas.before:
                            Color:
                                rgba: 0.95, 0.98, 0.95, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [10]
                        
                        BoxLayout:
                            padding: [15, 10]
                            Image:
                                source: 'assets/symptom_tracker.png'
                                size_hint: None, 1
                                width: self.height
                            Label:
                                text: 'Symptom Tracker \nMonitor your health with our easy-to-use symptom tracker'
                                color: 0.2, 0.2, 0.2, 1
                                text_size: self.width, None
                                valign: 'middle'
                                
                    # Feature 2
                    BoxLayout:
                        size_hint_y: None
                        height: 100
                        canvas.before:
                            Color:
                                rgba: 0.95, 0.98, 0.95, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [10]
                        
                        BoxLayout:
                            padding: [15, 10]
                            Image:
                                source: 'assets/doctor_connect.png'
                                size_hint: None, 1
                                width: self.height
                            Label:
                                text: 'Doctor Connect \nConsult with certified healthcare professionals'
                                color: 0.2, 0.2, 0.2, 1
                                text_size: self.width, None
                                valign: 'middle'
                                
                # Trending Now Section
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: 250
                    spacing: 10
                    
                    Label:
                        text: 'Trending Health Topics'
                        font_size: '20sp'
                        color: 0.2, 0.2, 0.2, 1
                        bold: True
                        size_hint_y: 0.3
                        
                    ScrollView:
                        size_hint_y: 0.7
                        do_scroll_x: True
                        do_scroll_y: False
                        
                        GridLayout:
                            cols: 3
                            spacing: 15
                            size_hint_x: None
                            width: self.minimum_width
                            height: self.minimum_height
                            
                            # Trending Item 1
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint: None, None
                                size: [200, 150]
                                canvas.before:
                                    Color:
                                        rgba: 0.95, 0.98, 0.95, 1
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [10]
                                
                                Image:
                                    source: 'assets/covid19.jpg'
                                    size_hint_y: 0.6
                                Label:
                                    text: 'COVID-19 Updates'
                                    font_size: '12sp'
                                    color: 0.2, 0.6, 0.4, 1
                                    bold: True
                                    
                            # Trending Item 2
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint: None, None
                                size: [200, 150]
                                canvas.before:
                                    Color:
                                        rgba: 0.95, 0.98, 0.95, 1
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [10]
                                
                                Image:
                                    source: 'assets/flu_season.jpg'
                                    size_hint_y: 0.6
                                Label:
                                    text: 'Flu Season Guide'
                                    font_size: '12sp'
                                    color: 0.2, 0.6, 0.4, 1
                                    bold: True
                                    
                            # Trending Item 3
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint: None, None
                                size: [200, 150]
                                canvas.before:
                                    Color:
                                        rgba: 0.95, 0.98, 0.95, 1
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [10]
                                
                                Image:
                                    source: 'assets/mental_health.jpg'
                                    size_hint_y: 0.6
                                Label:
                                    text: 'Mental Wellness'
                                    font_size: '12sp'
                                    color: 0.2, 0.6, 0.4, 1
                                    bold: True
        
        # Footer
        BoxLayout:
            size_hint_y: 0.08
            canvas.before:
                Color:
                    rgba: 0.1, 0.1, 0.1, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            
            Label:
                text: '© 2025 TrackHealth. All rights reserved.'
                color: 0.8, 0.8, 0.8, 1
                font_size: '12sp'