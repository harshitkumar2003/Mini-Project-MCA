<DoctorCard>:
    orientation: 'vertical'
    spacing: dp(10)
    padding: dp(15)
    size_hint: None, None
    width: 180
    height: 240
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [15,]
        Color:
            rgba: 0.95, 0.97, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [15,]
        Color:
            rgba: 0.2, 0.6, 0.4, 0.1
        Line:
            rounded_rectangle: [self.x, self.y, self.width, self.height, 15]
            width: 1.5

    Image:
        source: root.image_source if root.image_source else 'assets/doctor.png'
        size_hint: None, None
        size: 80, 80
        pos_hint: {'center_x': 0.5}
        mipmap: True
        canvas.before:
            Color:
                rgba: 0.9, 0.95, 1, 1
            Ellipse:
                pos: self.pos[0]-dp(5), self.pos[1]-dp(5)
                size: self.size[0]+dp(10), self.size[1]+dp(10)
            StencilPush
            Ellipse:
                pos: self.pos
                size: self.size
            StencilUse
        canvas.after:
            StencilUnUse
            Ellipse:
                pos: self.pos[0]-dp(0.5), self.pos[1]-dp(0.5)
                size: self.size[0]+dp(1), self.size[1]+dp(1)
            StencilUnUse

    Label:
        text: root.name
        font_size: '16sp'
        bold: True
        size_hint_y: None
        height: 25
        text_size: self.width, None
        halign: 'center'
        valign: 'middle'
        color: 0.1, 0.1, 0.1, 1

    Label:
        text: root.specialization
        font_size: '12sp'
        color: 0.4, 0.4, 0.4, 1
        size_hint_y: None
        height: 20
        text_size: self.width, None
        halign: 'center'
        valign: 'middle'
        font_name: 'Roboto'

    Label:
        text: root.available
        font_size: '10sp'
        color: 0.2, 0.6, 0.4, 1
        size_hint_y: None
        height: 18
        text_size: self.width, None
        halign: 'center'
        valign: 'middle'
        font_name: 'Roboto'

    Button:
        text: 'Book Appointment'
        size_hint_y: None
        height: dp(40)
        background_color: 0.2, 0.6, 0.4, 1
        background_normal: ''
        color: 1, 1, 1, 1
        font_size: '14sp'
        bold: True
        on_release: root.select_doctor()
        canvas.before:
            Color:
                rgba: 0.2, 0.6, 0.4, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [20,]
