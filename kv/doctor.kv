#:import get_color_from_hex kivy.utils.get_color_from_hex
#:import Graph kivy_garden.graph.Graph

# --- Custom Styles ---
<BoldLabel@Label>:
    bold: True
    color: get_color_from_hex("#000000")

<ActionButton@Button>:
    background_normal: ''
    color: get_color_from_hex("#FFFFFF")
    bold: True
    font_size: '14sp'

# --- NEW: POPUP LAYOUTS ---

<AlertsPopup>:
    size_hint: 0.85, 0.5
    background_color: 0, 0, 0, 0.5
    
    BoxLayout:
        orientation: 'vertical'
        padding: dp(0)
        spacing: dp(0)
        
        # Red Header
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            padding: dp(15)
            canvas.before:
                Color:
                    rgba: get_color_from_hex("#E74C3C")
                Rectangle:
                    pos: self.pos
                    size: self.size
            
            Label:
                text: "CRITICAL ALERTS"
                bold: True
                color: 1, 1, 1, 1
                halign: 'left'
                text_size: self.size
            
            Button:
                text: "X"
                size_hint_x: None
                width: dp(30)
                background_normal: ''
                background_color: 0,0,0,0
                bold: True
                on_release: root.dismiss()

        # White Body
        ScrollView:
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            
            BoxLayout:
                id: alert_container
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: dp(20)
                spacing: dp(10)

<AppointmentsPopup>:
    size_hint: 0.85, 0.6
    background_color: 0, 0, 0, 0.5
    
    BoxLayout:
        orientation: 'vertical'
        padding: dp(0)
        spacing: dp(0)
        
        # Blue Header
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            padding: dp(15)
            canvas.before:
                Color:
                    rgba: get_color_from_hex("#3498DB")
                Rectangle:
                    pos: self.pos
                    size: self.size
            
            Label:
                text: "TODAY'S APPOINTMENTS"
                bold: True
                color: 1, 1, 1, 1
                halign: 'left'
                text_size: self.size
            
            Button:
                text: "X"
                size_hint_x: None
                width: dp(30)
                background_normal: ''
                background_color: 0,0,0,0
                bold: True
                on_release: root.dismiss()

        # White Body
        ScrollView:
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            
            BoxLayout:
                id: appt_container
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: dp(20)
                spacing: dp(10)


# --- Main Dashboard Layout ---
<DoctorDashboard>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1 
        Rectangle:
            pos: self.pos
            size: self.size

    Image:
        source: 'assets/ill-2.png'
        allow_stretch: True
        keep_ratio: True    
        size_hint: 1, 1     
        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
        opacity: 0.25

    BoxLayout:
        orientation: 'vertical'
        spacing: 0 

        # TITLE BAR
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            orientation: 'horizontal'
            padding: [dp(10), 0]
            spacing: dp(15)
            
            canvas.before:
                Color:
                    rgba: get_color_from_hex("#2ECC71")
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: "←"
                font_size: '30sp'
                bold: True
                size_hint_x: None
                width: dp(40)
                background_normal: ''
                background_color: 0,0,0,0
                on_release: root.go_back()

            Label:
                text: 'Doctor Dashboard'
                font_size: '22sp'
                bold: True
                color: 1, 1, 1, 1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

        # SCROLLABLE CONTENT AREA
        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            
            BoxLayout:
                orientation: 'vertical'
                padding: dp(15)
                spacing: dp(10)
                size_hint_y: None
                height: self.minimum_height

                # Doctor Info Grid
                GridLayout:
                    cols: 4
                    size_hint_y: None
                    height: dp(80)
                    spacing: dp(10)
                    
                    BoldLabel:
                        text: 'Doctor Name:'
                        halign: 'right'
                    Label:
                        text: 'Dr. Suraj Tomer'
                        color: get_color_from_hex("#333333")
                        halign: 'left'
                        text_size: self.size
                        valign: 'middle'

                    BoldLabel:
                        text: 'Specialization:'
                        halign: 'right'
                    Label:
                        text: 'Orthopedix'
                        color: get_color_from_hex("#333333")
                        halign: 'left'
                        text_size: self.size
                        valign: 'middle'

                    BoldLabel:
                        text: 'Qualification:'
                        halign: 'right'
                    Label:
                        text: 'M.B.B.S'
                        color: get_color_from_hex("#333333")
                        halign: 'left'
                        text_size: self.size
                        valign: 'middle'

                    BoldLabel:
                        text: 'Clinic Hospital:'
                        halign: 'right'
                    Label:
                        text: 'Lakshya Hospital'
                        color: get_color_from_hex("#333333")
                        halign: 'left'
                        text_size: self.size
                        valign: 'middle'

                # Patient List Title
                BoldLabel:
                    text: 'My Patients Overview'
                    font_size: '24sp'
                    size_hint_y: None
                    height: dp(50)
                    text_size: self.size
                    halign: 'left'
                    valign: 'bottom'

                # PATIENT OVERVIEW SECTION
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(250)
                    padding: dp(2)
                    
                    canvas.before:
                        Color:
                            rgba: 0, 0, 0, 1
                        Line:
                            width: 1.5
                            rectangle: self.x, self.y, self.width, self.height

                    ScrollView:
                        do_scroll_x: False
                        bar_width: dp(10)
                        
                        GridLayout:
                            id: patient_grid_id 
                            cols: 1
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: dp(2)

                # Quick Actions Title
                BoldLabel:
                    text: 'Quick Actions'
                    font_size: '20sp'
                    size_hint_y: None
                    height: dp(40)
                    text_size: self.size
                    halign: 'left'
                    valign: 'bottom'

                # Quick Action Buttons
                GridLayout:
                    cols: 3
                    size_hint_y: None
                    height: dp(50)
                    spacing: dp(10)

                    ActionButton:
                        text: "New Alert (2)"
                        background_color: get_color_from_hex("#E74C3C")
                        on_release: root.show_alerts()

                    ActionButton:
                        text: "Appointments (3)"
                        background_color: get_color_from_hex("#3498DB")
                        on_release: root.show_appointments()
                    
                # Graph Title
                BoldLabel:
                    text: 'Overall Patient Vitals Trend'
                    font_size: '20sp'
                    size_hint_y: None
                    height: dp(40)
                    text_size: self.size
                    halign: 'left'
                    valign: 'bottom'

                # Graph Section
                AnchorLayout:
                    anchor_x: 'center'
                    anchor_y: 'center'
                    size_hint_y: None
                    height: dp(300) 
                    
                    Graph:
                        id: trend_graph
                        xlabel: 'Time (s)'
                        ylabel: 'Avg. HR'
                        x_ticks_minor: 1
                        x_ticks_major: 1
                        y_ticks_major: 10
                        y_grid_label: True
                        x_grid_label: True
                        padding: dp(5)
                        x_grid: True
                        y_grid: True
                        xmin: 0
                        xmax: 11
                        ymin: 50
                        ymax: 90
                        label_options: {'color': get_color_from_hex("#000000"), 'bold': True}
                        background_color: 0, 0, 0, 0 
                        tick_color: get_color_from_hex("#888888")
                        border_color: get_color_from_hex("#888888")