#:import get_color_from_hex kivy.utils.get_color_from_hex
#:import Graph kivy_garden.graph.Graph

# --- Custom Styles ---
<BoldLabel@Label>:
    bold: True
    color: get_color_from_hex("#000000")

<ActionButton@Button>:
    background_normal: ''
    color: get_color_from_hex("#FFFFFF")
    bold: True
    font_size: '14sp'

# --- Main Dashboard Layout ---
<DoctorDashboard>:
    # 1. BASE LAYER: Solid White Canvas
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1 # White
        Rectangle:
            pos: self.pos
            size: self.size

    # 2. BACKGROUND IMAGE LAYER (Fixed, does not scroll)
    Image:
        source: 'assets/ill-2.png'  # Ensure your image path is correct
        allow_stretch: True
        keep_ratio: True    
        size_hint: 1, 1     
        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
        opacity: 0.25

    # 3. MAIN LAYOUT STRUCTURE
    BoxLayout:
        orientation: 'vertical'
        spacing: 0 

        # ==========================================
        # TITLE BAR (Fixed at Top)
        # ==========================================
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            orientation: 'horizontal'
            padding: [dp(10), 0]
            spacing: dp(15)
            
            canvas.before:
                Color:
                    rgba: get_color_from_hex("#2ECC71") # Medical Blue
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: "←"
                font_size: '30sp'
                bold: True
                size_hint_x: None
                width: dp(40)
                background_normal: ''
                background_color: 0,0,0,0
                on_release: root.go_back()

            Label:
                text: 'Doctor Dashboard'
                font_size: '22sp'
                bold: True
                color: 1, 1, 1, 1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

        # ==========================================
        # SCROLLABLE CONTENT AREA
        # ==========================================
