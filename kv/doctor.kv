                    size_hint_y: None
                    height: dp(40)
                    text_size: self.size
                    halign: 'left'
                    valign: 'bottom'

                # --- PATIENT OVERVIEW SECTION (Nested Scroll) ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(250) # FIXED HEIGHT ensures inner scroll works
                    padding: dp(2)
                    
                    canvas.before:
                        Color:
                            rgba: 0, 0, 0, 1
                        Line:
                            width: 1.5
                            rectangle: self.x, self.y, self.width, self.height

                    ScrollView:
                        do_scroll_x: False
                        bar_width: dp(10)
                        
                        GridLayout:
                            id: patient_grid_id 
                            cols: 1
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: dp(2)

                # --- Quick Actions Title ---
                BoldLabel:
                    text: 'Quick Actions'
                    font_size: '20sp'
                    size_hint_y: None
                    height: dp(40)
                    text_size: self.size
                    halign: 'left'
                    valign: 'bottom'

                # --- Quick Action Buttons ---
                GridLayout:
                    cols: 3
                    size_hint_y: None
                    height: dp(50)
                    spacing: dp(10)

                    ActionButton:
                        text: "New Alert (2)"
                        background_color: get_color_from_hex("#E74C3C")
                    ActionButton:
                        text: "Appointments (3)"
                        background_color: get_color_from_hex("#3498DB")
                    ActionButton:
                        text: "View Reports"
                        background_color: get_color_from_hex("#2ECC71")

                # --- Graph Title ---
                BoldLabel:
                    text: 'Overall Patient Vitals Trend'
                    font_size: '20sp'
                    size_hint_y: None
                    height: dp(40)
                    text_size: self.size
                    halign: 'left'
                    valign: 'bottom'

                # --- Graph Section ---
                AnchorLayout:
                    anchor_x: 'center'
                    anchor_y: 'center'
                    size_hint_y: None
                    height: dp(300) # Fixed height for graph
                    
                    Graph:
                        id: trend_graph
                        xlabel: 'Time (s)'
                        ylabel: 'Avg. HR'
                        x_ticks_minor: 1
                        x_ticks_major: 1
                        y_ticks_major: 10
                        y_grid_label: True
                        x_grid_label: True
                        padding: dp(5)
                        x_grid: True
                        y_grid: True
                        xmin: 0
                        xmax: 11
                        ymin: 50
                        ymax: 90
                        label_options: {'color': get_color_from_hex("#000000"), 'bold': True}
                        background_color: 0, 0, 0, 0 
                        tick_color: get_color_from_hex("#888888")
                        border_color: get_color_from_hex("#888888")