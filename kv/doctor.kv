#:import get_color_from_hex kivy.utils.get_color_from_hex
#:import Graph kivy_garden.graph.Graph

# --- Custom Styles ---
<BoldLabel@Label>:
    bold: True
    color: get_color_from_hex("#000000")

<ActionButton@Button>:
    background_normal: ''
    color: get_color_from_hex("#FFFFFF")
    bold: True
    font_size: '16sp'

# --- Main Dashboard Layout ---
<DoctorDashboard>:
    # 1. BASE LAYER: Solid White Canvas (Fills any gaps in image aspect ratio)
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1 # White
        Rectangle:
            pos: self.pos
            size: self.size

    # 2. BACKGROUND IMAGE LAYER
    # This sits on top of the white canvas, but behind the main content BoxLayout.
    Image:
        source: 'background_image.png'  # Ensure your image is named exactly this
        allow_stretch: True
        keep_ratio: True    # Keeps the illustration from looking squashed
        size_hint: 1, 1     # Tries to fill the screen
        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
        # IMPORTANT: Lowered opacity makes the background faint so text is readable.
        # Increase this value (up to 1.0) to make the image darker/clearer.
        opacity: 0.25

    # 3. CONTENT LAYER (The Dashboard UI)
    BoxLayout:
        orientation: 'vertical'
        spacing: 0 # No spacing between title bar and content

        # ==========================================
        # TITLE BAR (Top Section)
        # ==========================================
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            orientation: 'horizontal'
            padding: [dp(10), 0] # Padding left/right only
            spacing: dp(15)
            
            # Blue Background for Title Bar
            canvas.before:
                Color:
                    rgba: get_color_from_hex("#3498DB") # Medical Blue
                Rectangle:
                    pos: self.pos
                    size: self.size

            # Back Arrow Button
            Button:
                text: "←" # Unicode Arrow
                font_size: '30sp'
                bold: True
                size_hint_x: None
                width: dp(40)
                background_normal: ''
                background_color: 0,0,0,0 # Transparent background
                on_release: root.go_back()

            # Dashboard Title
            Label:
                text: 'Doctor Dashboard'
                font_size: '22sp'
                bold: True
                color: 1, 1, 1, 1 # White Text
                halign: 'left'
                valign: 'middle'
                text_size: self.size

        # ==========================================
        # CONTENT AREA (Bottom Section)
        # ==========================================
        BoxLayout:
            orientation: 'vertical'
            padding: dp(15)
            spacing: dp(10)

            # --- Doctor Info Grid ---
            GridLayout:
                cols: 4
                size_hint_y: 0.1
                spacing: dp(10)
                
                BoldLabel:
                    text: 'Doctor Name:'
                    halign: 'right'
                Label:
                    text: 'Dr. Suraj Tomer'
                    color: get_color_from_hex("#333333")
                    halign: 'left'
                    text_size: self.size
                    valign: 'middle'

                BoldLabel:
                    text: 'Specialization:'
                    halign: 'right'
                Label:
                    text: 'Orthopeidx'
                    color: get_color_from_hex("#333333")
                    halign: 'left'
                    text_size: self.size
                    valign: 'middle'

                BoldLabel:
                    text: 'Qualification:'
                    halign: 'right'
                Label:
                    text: 'MBBS'
                    color: get_color_from_hex("#333333")
                    halign: 'left'
                    text_size: self.size
                    valign: 'middle'

                BoldLabel:
                    text: 'Clinic Hospital:'
                    halign: 'right'
                Label:
                    text: 'Lakshya Hospital'
                    color: get_color_from_hex("#333333")
                    halign: 'left'
                    text_size: self.size
                    valign: 'middle'

            # --- Patient List Title ---
            BoldLabel:
                text: 'My Patients Overview'
                font_size: '24sp'
                size_hint_y: 0.06
                text_size: self.size
                halign: 'left'
                valign: 'bottom'

            # --- PATIENT OVERVIEW SECTION ---
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 0.35
                padding: dp(2)
                
                # Black border around list
                canvas.before:
                    Color:
                        rgba: 0, 0, 0, 1
                    Line:
                        width: 1.5
                        rectangle: self.x, self.y, self.width, self.height

                ScrollView:
                    do_scroll_x: False
                    bar_width: dp(10)
                    
                    GridLayout:
                        id: patient_grid_id 
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(2)

            # --- Quick Actions ---
            BoldLabel:
                text: 'Quick Actions'
                font_size: '20sp'
                size_hint_y: 0.06
                text_size: self.size
                halign: 'left'
                valign: 'bottom'

            GridLayout:
                cols: 3
                size_hint_y: 0.08
                spacing: dp(10)

                ActionButton:
                    text: "New Alert (2)"
                    background_color: get_color_from_hex("#E74C3C")
                ActionButton:
                    text: "Appointments (3)"
                    background_color: get_color_from_hex("#3498DB")
                ActionButton:
                    text: "View Reports"
                    background_color: get_color_from_hex("#2ECC71")

            # --- Graph Section ---
            BoldLabel:
                text: 'Overall Patient Vitals Trend'
                font_size: '20sp'
                size_hint_y: 0.06
                text_size: self.size
                halign: 'left'
                valign: 'bottom'

            AnchorLayout:
                anchor_x: 'center'
                anchor_y: 'center'
                size_hint_y: 0.35
                
                Graph:
                    id: trend_graph
                    xlabel: 'Time (s)'
                    ylabel: 'Avg. HR'
                    x_ticks_minor: 1
                    x_ticks_major: 1
                    y_ticks_major: 10
                    y_grid_label: True
                    x_grid_label: True
                    padding: dp(5)
                    x_grid: True
                    y_grid: True
                    xmin: 0
                    xmax: 11
                    ymin: 50
                    ymax: 90
                    label_options: {'color': get_color_from_hex("#000000"), 'bold': True}
                    background_color: 0, 0, 0, 0 
                    tick_color: get_color_from_hex("#888888")
                    border_color: get_color_from_hex("#888888")