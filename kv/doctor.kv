#:import get_color_from_hex kivy.utils.get_color_from_hex
#:import Graph kivy_garden.graph.Graph

# --- Custom Styles ---
<BoldLabel@Label>:
    bold: True
    color: get_color_from_hex("#000000")

<ActionButton@Button>:
    background_normal: ''
    color: get_color_from_hex("#FFFFFF")
    bold: True
    font_size: '14sp'

# --- Main Dashboard Layout ---
<DoctorDashboard>:
    # 1. BASE LAYER: Solid White Canvas
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1 # White
        Rectangle:
            pos: self.pos
            size: self.size

    # 2. BACKGROUND IMAGE LAYER (Fixed, does not scroll)
    Image:
        source: 'assets/ill-2.png'  # Ensure your image path is correct
        allow_stretch: True
        keep_ratio: True    
        size_hint: 1, 1     
        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
        opacity: 0.1  # Reduced opacity for better text visibility
        # Ensure background stays in the background
        canvas.before:
            StencilPush
            Rectangle:
                pos: self.pos
                size: self.size
        canvas.after:
            StencilUnUse
            Rectangle:
                pos: self.pos
                size: self.size
            StencilPop

    # 3. MAIN LAYOUT STRUCTURE
    BoxLayout:
        orientation: 'vertical'
        spacing: 0 

        # ==========================================
        # TITLE BAR (Fixed at Top)
        # ==========================================
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            orientation: 'horizontal'
            padding: [dp(10), 0]
            spacing: dp(15)
            
            canvas.before:
                Color:
                    rgba: get_color_from_hex("#2ECC71") # Medical Blue
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: "<-"
                font_size: '30sp'
                bold: True
                size_hint_x: None
                width: dp(40)
                background_normal: ''
                background_color: 0,0,0,0
                on_release: root.go_back()

            Label:
                text: 'Doctor Dashboard'
                font_size: '22sp'
                bold: True
                color: 1, 1, 1, 1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

        # ==========================================
        # SCROLLABLE CONTENT AREA
        # ==========================================
        ScrollView:
            id: main_scroll
            do_scroll_x: False
            do_scroll_y: True
            bar_width: dp(8)
            bar_color: get_color_from_hex("#2ECC77")
            bar_inactive_color: get_color_from_hex("#A5D6A7")
            bar_margin: dp(2)
            scroll_type: ['bars', 'content']
            effect_cls: 'ScrollEffect'
            
            # The container for all content
            GridLayout:
                id: content_container
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(15), dp(15), dp(15), dp(15)]  # top, right, bottom, left
                spacing: dp(15)
                canvas.before:
                    Color:
                        rgba: 1, 1, 1, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size
                
                # --- Doctor Info Card ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(15)
                    spacing: dp(10)
                    canvas.before:
                        Color:
                            rgba: get_color_from_hex("#FFFFFF")
                        RoundedRectangle:
                            size: self.size
                            pos: self.pos
                            radius: [10,]
                        Color:
                            rgba: get_color_from_hex("#E0E0E0")
                        Line:
                            rounded_rectangle: [self.x, self.y, self.width, self.height, 10]
                            width: 1
                    
                    # Shadow effect
                    canvas.after:
                        Color:
                            rgba: 0, 0, 0, 0.1
                        RoundedRectangle:
                            size: (self.width + 10, self.height + 10)
                            pos: (self.x - 5, self.y - 5)
                            radius: [10,]
                    
                    Label:
                        text: 'Doctor Profile'
                        font_size: '18sp'
                        bold: True
                        size_hint_y: None
                        height: dp(30)
                        color: get_color_from_hex("#2C3E50")
                        
                    GridLayout:
                        cols: 2
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: [dp(10), dp(8)]  # horizontal, vertical spacing
                    
                    BoldLabel:
                        text: 'Doctor Name:'
                        halign: 'left'
                    Label:
                        text: 'Dr. Suraj Tomer'
                        color: get_color_from_hex("#333333")
                        halign: 'right'
                        text_size: self.size
                        valign: 'middle'

                    BoldLabel:
                        text: 'Specialization:'
                        halign: 'left'
                    Label:
                        text: 'Orthopedics'
                        color: get_color_from_hex("#333333")
                        halign: 'right'
                        text_size: self.size
                        valign: 'middle'

                    BoldLabel:
                        text: 'Qualification:'
                        halign: 'left'
                    Label:
                        text: 'MBBS'
                        color: get_color_from_hex("#333333")
                        halign: 'right'
                        text_size: self.size
                        valign: 'middle'

                    BoldLabel:
                        text: 'Clinic:'
                        halign: 'left'
                    Label:
                        text: 'Lakshya Hospital'
                        color: get_color_from_hex("#333333")
                        halign: 'right'
                        text_size: self.size
                        valign: 'middle'

                # --- Section Spacer ---
                BoxLayout:
                    size_hint_y: None
                    height: dp(10)
                    
                # --- Patient List Header ---
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(40)
                    
                    BoldLabel:
                        text: 'My Patients Overview'
                        font_size: '20sp'
                        text_size: self.size
                        halign: 'left'
                        valign: 'middle'
                        color: get_color_from_hex("#2C3E50")
                        
                    Label:
                        text: 'View All >'
                        color: get_color_from_hex("#2ECC77")
                        font_size: '14sp'
                        size_hint_x: 0.3
                        text_size: self.size
                        halign: 'right'
                        valign: 'middle'

                # --- PATIENT OVERVIEW SECTION ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(300)  # Increased height for better visibility
                    padding: dp(15)
                    spacing: dp(10)
                    
                    canvas.before:
                        Color:
                            rgba: get_color_from_hex("#FFFFFF")
                        RoundedRectangle:
                            size: self.size
                            pos: self.pos
                            radius: [10,]
                        Color:
                            rgba: get_color_from_hex("#E0E0E0")
                        Line:
                            rounded_rectangle: [self.x, self.y, self.width, self.height, 10]
                            width: 1
                    
                    # Patient list header
                    BoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        padding: [0, 0, dp(5), 0]  # Right padding for scrollbar
                        
                        Label:
                            text: 'Patient Name'
                            color: get_color_from_hex("#666666")
                            font_size: '14sp'
                            bold: True
                            size_hint_x: 0.4
                            
                        Label:
                            text: 'Last Visit'
                            color: get_color_from_hex("#666666")
                            font_size: '14sp'
                            bold: True
                            size_hint_x: 0.3
                            
                        Label:
                            text: 'Status'
                            color: get_color_from_hex("#666666")
                            font_size: '14sp'
                            bold: True
                            size_hint_x: 0.3
                    
                    # Scrollable patient list
                    ScrollView:
                        id: patient_scroll
                        size_hint_y: 1
                        do_scroll_x: False
                        bar_width: dp(5)
                        bar_color: get_color_from_hex("#2ECC77")
                        bar_inactive_color: get_color_from_hex("#A5D6A7")
                        bar_margin: dp(1)
                        scroll_type: ['bars', 'content']
                        effect_cls: 'ScrollEffect'
                        
                        GridLayout:
                            id: patient_grid_id 
                            cols: 1
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: dp(8)
                            padding: [0, 0, dp(5), 0]  # Right padding for scrollbar

                # --- Section Spacer ---
                BoxLayout:
                    size_hint_y: None
                    height: dp(10)
                    
                # --- Quick Actions Title ---
                BoldLabel:
                    text: 'Quick Actions'
                    font_size: '20sp'
                    size_hint_y: None
                    height: dp(40)
                    text_size: self.size
                    halign: 'left'
                    valign: 'bottom'
                    color: get_color_from_hex("#2C3E50")

                # --- Quick Action Buttons ---
                GridLayout:
                    cols: 3
                    size_hint_y: None
                    height: dp(50)
                    spacing: dp(10)

                    ActionButton:
                        text: "New Alert (2)"
                        background_color: get_color_from_hex("#E74C3C")
                    ActionButton:
                        text: "Appointments (3)"
                        background_color: get_color_from_hex("#3498DB")
                    ActionButton:
                        text: "View Reports"
                        background_color: get_color_from_hex("#2ECC71")

                # --- Section Spacer ---
                BoxLayout:
                    size_hint_y: None
                    height: dp(10)
                    
                # --- Graph Title ---
                BoldLabel:
                    text: 'Overall Patient Vitals Trend'
                    font_size: '20sp'
                    size_hint_y: None
                    height: dp(40)
                    text_size: self.size
                    halign: 'left'
                    valign: 'bottom'
                    color: get_color_from_hex("#2C3E50")

                # --- Graph Section ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(350)  # Increased height for better visibility
                    padding: dp(15)
                    spacing: dp(10)
                    canvas.before:
                        Color:
                            rgba: get_color_from_hex("#FFFFFF")
                        RoundedRectangle:
                            size: self.size
                            pos: self.pos
                            radius: [10,]
                        Color:
                            rgba: get_color_from_hex("#E0E0E0")
                        Line:
                            rounded_rectangle: [self.x, self.y, self.width, self.height, 10]
                            width: 1
                    
                    # Graph title and controls
                    BoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        padding: [0, 0, dp(10), 0]  # Right padding for controls
                        
                        Label:
                            text: 'Patient Vitals Trend (Last 7 Days)'
                            color: get_color_from_hex("#2C3E50")
                            font_size: '16sp'
                            bold: True
                            size_hint_x: 0.7
                            
                        # Graph controls would go here
                        # Example: Time range selector
                        Spinner:
                            text: 'Weekly'
                            values: ['Daily', 'Weekly', 'Monthly']
                            size_hint_x: 0.3
                            background_color: get_color_from_hex("#2ECC77")
                            color: 1, 1, 1, 1
                            font_size: '12sp'
                    
                    # Graph container
                    BoxLayout:
                        size_hint_y: 1
                        padding: [dp(5), dp(5), dp(15), dp(15)]  # Add padding for axes
                    
                    Graph:
                        id: trend_graph
                        xlabel: 'Time (s)'
                        ylabel: 'Avg. HR'
                        x_ticks_minor: 1
                        x_ticks_major: 1
                        y_ticks_major: 10
                        y_grid_label: True
                        x_grid_label: True
                        padding: dp(5)
                        x_grid: True
                        y_grid: True
                        xmin: 0
                        xmax: 11
                        ymin: 50
                        ymax: 90
                        label_options: {'color': get_color_from_hex("#000000"), 'bold': True}
                        background_color: 0, 0, 0, 0 
                        tick_color: get_color_from_hex("#888888")
                        border_color: get_color_from_hex("#888888")
